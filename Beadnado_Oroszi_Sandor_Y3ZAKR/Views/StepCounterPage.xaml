<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Beadnado_Oroszi_Sandor_Y3ZAKR.ViewModels"
             xmlns:models="clr-namespace:Beadnado_Oroszi_Sandor_Y3ZAKR.Models"
             xmlns:conv="clr-namespace:Beadnado_Oroszi_Sandor_Y3ZAKR.Converters"
             x:Class="Beadnado_Oroszi_Sandor_Y3ZAKR.Views.StepCounterPage"
             x:DataType="vm:StepCounterViewModel"
             Title="Lépésszámláló">

    <!-- A ViewModel példányosítása XAML-ből (DI nélkül) -->
    <ContentPage.BindingContext>
        <vm:StepCounterViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <conv:InvertedBoolConverter x:Key="InvertBool" />
        <conv:BoolToColorConverter x:Key="GoalColor"
                                   TrueColor="ForestGreen"
                                   FalseColor="{StaticResource Primary}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- 1. Lépésszám és haladás -->
        <Border Grid.Row="0" Padding="16" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding Steps}"
                       FontSize="64" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{Binding IsGoalReached, Converter={StaticResource GoalColor}}" />

                <ProgressBar Progress="{Binding Progress}"
                             ProgressColor="{Binding IsGoalReached, Converter={StaticResource GoalColor}}" />

                <Label Text="{Binding ProgressText}" HorizontalOptions="Center" />
                <Label Text="{Binding DistanceKm, StringFormat='Megtett táv: {0:F2} km'}"
                       HorizontalOptions="Center" />
                <Label Text="{Binding StatusMessage}" HorizontalOptions="Center"
                       FontAttributes="Italic" />

                <!-- Nyers szenzoradatok -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="{Binding X, StringFormat='X: {0:F2}'}" />
                    <Label Text="{Binding Y, StringFormat='Y: {0:F2}'}" />
                    <Label Text="{Binding Z, StringFormat='Z: {0:F2}'}" />
                    <Label Text="{Binding Magnitude, StringFormat='|a|: {0:F2} g'}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- 2. Beállítások (TwoWay kötések) és gombok -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Grid ColumnDefinitions="Auto,*,80" ColumnSpacing="8">
                <Label Text="Cél:" VerticalOptions="Center" />
                <!-- A Slider és az Entry UGYANAHHOZ a tulajdonsághoz kötődik -> szinkronban maradnak -->
                <Slider Grid.Column="1" Minimum="1" Maximum="10000"
                        Value="{Binding Goal, Mode=TwoWay}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
                <Entry Grid.Column="2" Keyboard="Numeric"
                       Text="{Binding Goal, Mode=TwoWay}"
                       IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Label Text="Lépéshossz:" VerticalOptions="Center" />
                <Slider Grid.Column="1" Minimum="40" Maximum="120"
                        Value="{Binding StepLengthCm, Mode=TwoWay}" />
                <Label Grid.Column="2" VerticalOptions="Center"
                       Text="{Binding StepLengthCm, StringFormat='{0:F0} cm'}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Start" Clicked="OnStartClicked"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" />
                <Button Grid.Column="1" Text="Stop" Clicked="OnStopClicked"
                        IsEnabled="{Binding IsRunning}" />
                <Button Grid.Column="2" Text="Nullázás" Clicked="OnResetClicked" />
            </Grid>
            <Button Text="+1 lépés (emulátor teszt)" Clicked="OnSimulateClicked"
                    IsEnabled="{Binding IsRunning}"
                    BackgroundColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <!-- 3. Korábbi mérések listája (ObservableCollection-höz kötve) -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Sessions}">
            <CollectionView.Header>
                <Label Text="Korábbi mérések" FontSize="18" FontAttributes="Bold" Margin="0,0,0,6" />
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Még nincs mentett mérés." HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:StepSession">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="4,6">
                        <Label Text="{Binding StartTime, StringFormat='{0:yyyy.MM.dd HH:mm}'}" />
                        <Label Grid.Column="1" Text="{Binding DurationText}" />
                        <Label Grid.Column="2" Text="{Binding Steps, StringFormat='{0} lépés'}"
                               FontAttributes="Bold">
                            <!-- Adatkötött trigger: ha a cél teljesült, zöld a szöveg -->
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding GoalReached}" Value="True">
                                    <Setter Property="TextColor" Value="ForestGreen" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
