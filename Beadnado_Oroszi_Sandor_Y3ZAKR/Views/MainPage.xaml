<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Beadnado_Oroszi_Sandor_Y3ZAKR.ViewModels"
             xmlns:conv="clr-namespace:Beadnado_Oroszi_Sandor_Y3ZAKR.Converters"
             x:Class="Beadnado_Oroszi_Sandor_Y3ZAKR.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Mobile Motion Tracker"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}">

    <!-- A ViewModel példányosítása XAML-ből (DI nélkül) -->
    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <!-- IValueConverter XAML-erőforrásként regisztrálva -->
        <conv:MotionStateColorConverter x:Key="MotionStateColor" />

        <!-- Színpaletta -->
        <Color x:Key="BgColor">#0B1020</Color>
        <Color x:Key="CardColor">#141B2F</Color>
        <Color x:Key="TileColor">#0F1526</Color>
        <Color x:Key="StrokeColor">#26324F</Color>
        <Color x:Key="TextColor">#E5E7EB</Color>
        <Color x:Key="MutedColor">#8A97B5</Color>
        <Color x:Key="LocationAccent">#22D3EE</Color>
        <Color x:Key="AccelAccent">#A78BFA</Color>
        <Color x:Key="CompassAccent">#FBBF24</Color>
        <Color x:Key="AxisX">#F472B6</Color>
        <Color x:Key="AxisY">#34D399</Color>
        <Color x:Key="AxisZ">#60A5FA</Color>
        <Color x:Key="ErrorColor">#F87171</Color>
        <Color x:Key="SuccessColor">#4ADE80</Color>

        <!-- Implicit stílusok (csak erre az oldalra) -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextColor}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Switch">
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="On">
                            <VisualState.Setters>
                                <Setter Property="OnColor" Value="#7C3AED" />
                                <Setter Property="ThumbColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Off">
                            <VisualState.Setters>
                                <Setter Property="ThumbColor" Value="#8A97B5" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="ThumbColor" Value="#404A63" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="HeightRequest" Value="8" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
            <Setter Property="Stroke" Value="{StaticResource StrokeColor}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Shadow">
                <Shadow Brush="Black" Opacity="0.45" Radius="18" Offset="0,8" />
            </Setter>
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource TileColor}" />
            <Setter Property="Stroke" Value="{StaticResource StrokeColor}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="WidthRequest" Value="46" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        </Style>

        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
            <Setter Property="CharacterSpacing" Value="1" />
        </Style>

        <Style x:Key="BigValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        </Style>

        <Style x:Key="AxisValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="64" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.97" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.5" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- A teljes oldalt ScrollView veszi körül, így kis kijelzőn is minden elérhető -->
    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,32" Spacing="18">

            <!-- ================= FEJLÉC ================= -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="20,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D28D9" Offset="0" />
                        <GradientStop Color="#2563EB" Offset="0.6" />
                        <GradientStop Color="#0891B2" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#6D28D9" Opacity="0.5" Radius="24" Offset="0,10" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                    <Label Text="MOBILE" FontSize="12" CharacterSpacing="4"
                           TextColor="#DDE7FF" FontFamily="OpenSansSemibold" />
                    <Label Grid.Row="1" Text="Motion Tracker" FontSize="30"
                           FontFamily="OpenSansSemibold" TextColor="White" />
                    <Label Grid.Row="2" Text="Hely · Gyorsulás · Irány"
                           FontSize="13" TextColor="#DDE7FF" />

                    <Border Grid.Column="1" Grid.RowSpan="3" VerticalOptions="Start"
                            BackgroundColor="#33FFFFFF" StrokeThickness="0"
                            StrokeShape="RoundRectangle 12" Padding="10,6">
                        <Label Text="{Binding ActiveSensorsText, Mode=OneWay}"
                               FontSize="11" TextColor="White" FontFamily="OpenSansSemibold" />
                    </Border>
                </Grid>
            </Border>

            <!-- ================= 1. HELYMEGHATÁROZÁS ================= -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Style="{StaticResource IconBadge}" BackgroundColor="#1A22D3EE">
                            <Label Text="📍" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Helymeghatározás" Style="{StaticResource SectionTitle}" />
                            <Label Text="GPS / hálózati pozíció" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Tile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SZÉLESSÉG" Style="{StaticResource FieldLabel}" />
                                <Label Style="{StaticResource BigValue}" TextColor="{StaticResource LocationAccent}"
                                       Text="{Binding Latitude, Mode=OneWay, StringFormat='{0:F4}°', TargetNullValue='–'}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Tile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="HOSSZÚSÁG" Style="{StaticResource FieldLabel}" />
                                <Label Style="{StaticResource BigValue}" TextColor="{StaticResource LocationAccent}"
                                       Text="{Binding Longitude, Mode=OneWay, StringFormat='{0:F4}°', TargetNullValue='–'}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <Label Style="{StaticResource Caption}"
                               Text="{Binding Accuracy, Mode=OneWay, StringFormat='Pontosság: ±{0:F0} m', TargetNullValue='Pontosság: –'}" />
                        <Label Grid.Column="1" Style="{StaticResource Caption}" HorizontalTextAlignment="End"
                               Text="{Binding LastLocationTime, Mode=OneWay, StringFormat='Frissítve: {0}'}" />
                    </Grid>

                    <Button Text="Helyzet lekérdezése"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GetLocationCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0891B2" Offset="0" />
                                <GradientStop Color="#2563EB" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="Állapot:" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" FontSize="13" VerticalOptions="Center"
                               TextColor="{StaticResource MutedColor}"
                               Text="{Binding LocationStatus, Mode=OneWay}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLocationError}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLocationSuccess}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <ActivityIndicator Grid.Column="2" WidthRequest="20" HeightRequest="20"
                                           Color="{StaticResource LocationAccent}"
                                           IsRunning="{Binding IsBusy, Mode=OneWay}"
                                           IsVisible="{Binding IsBusy, Mode=OneWay}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ================= 2. GYORSULÁSMÉRŐ ================= -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource IconBadge}" BackgroundColor="#1AA78BFA">
                            <Label Text="📈" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Gyorsulásmérő" Style="{StaticResource SectionTitle}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding AccelerometerStatus, Mode=OneWay}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                            <Label Text="Mérés" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            <Switch IsToggled="{Binding IsAccelerometerOn, Mode=TwoWay}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Tengelyek: középről induló sáv (balra negatív, jobbra pozitív) -->
                    <Border Style="{StaticResource Tile}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="28,*,*,Auto" ColumnSpacing="0">
                                <Label Text="X:" FontFamily="OpenSansSemibold" TextColor="{StaticResource AxisX}" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" ScaleX="-1" ProgressColor="{StaticResource AxisX}"
                                             Progress="{Binding XNegative, Mode=OneWay}" />
                                <ProgressBar Grid.Column="2" ProgressColor="{StaticResource AxisX}"
                                             Progress="{Binding XPositive, Mode=OneWay}" />
                                <Label Grid.Column="3" Style="{StaticResource AxisValue}"
                                       Text="{Binding X, Mode=OneWay, StringFormat='{0:F2}', TargetNullValue='–'}" />
                            </Grid>
                            <Grid ColumnDefinitions="28,*,*,Auto" ColumnSpacing="0">
                                <Label Text="Y:" FontFamily="OpenSansSemibold" TextColor="{StaticResource AxisY}" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" ScaleX="-1" ProgressColor="{StaticResource AxisY}"
                                             Progress="{Binding YNegative, Mode=OneWay}" />
                                <ProgressBar Grid.Column="2" ProgressColor="{StaticResource AxisY}"
                                             Progress="{Binding YPositive, Mode=OneWay}" />
                                <Label Grid.Column="3" Style="{StaticResource AxisValue}"
                                       Text="{Binding Y, Mode=OneWay, StringFormat='{0:F2}', TargetNullValue='–'}" />
                            </Grid>
                            <Grid ColumnDefinitions="28,*,*,Auto" ColumnSpacing="0">
                                <Label Text="Z:" FontFamily="OpenSansSemibold" TextColor="{StaticResource AxisZ}" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" ScaleX="-1" ProgressColor="{StaticResource AxisZ}"
                                             Progress="{Binding ZNegative, Mode=OneWay}" />
                                <ProgressBar Grid.Column="2" ProgressColor="{StaticResource AxisZ}"
                                             Progress="{Binding ZPositive, Mode=OneWay}" />
                                <Label Grid.Column="3" Style="{StaticResource AxisValue}"
                                       Text="{Binding Z, Mode=OneWay, StringFormat='{0:F2}', TargetNullValue='–'}" />
                            </Grid>
                            <Label Text="Tengelyértékek g egységben (skála: ±2 g)" Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Tile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="GYORSULÁS" Style="{StaticResource FieldLabel}" />
                                <Label Style="{StaticResource BigValue}" TextColor="{StaticResource AccelAccent}"
                                       Text="{Binding Magnitude, Mode=OneWay, StringFormat='{0:F2} g', TargetNullValue='– g'}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Tile}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="MOZGÁS" Style="{StaticResource FieldLabel}" />
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"
                                             Color="{Binding MotionState, Mode=OneWay, Converter={StaticResource MotionStateColor}}" />
                                    <!-- A mozgásállapot színe a MotionStateColorConverter-en keresztül -->
                                    <Label FontFamily="OpenSansSemibold" FontSize="17" VerticalOptions="Center"
                                           Text="{Binding MotionState, Mode=OneWay}"
                                           TextColor="{Binding MotionState, Mode=OneWay, Converter={StaticResource MotionStateColor}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Eltérés a nyugalmi 1 g-től (d = |a − 1|)" Style="{StaticResource Caption}" />
                            <Label Grid.Column="1" Style="{StaticResource Caption}"
                                   Text="{Binding Deviation, Mode=OneWay, StringFormat='{0:F2}', TargetNullValue='–'}" />
                        </Grid>
                        <ProgressBar Progress="{Binding DeviationBar, Mode=OneWay}"
                                     ProgressColor="{Binding MotionState, Mode=OneWay, Converter={StaticResource MotionStateColor}}" />
                        <Grid ColumnDefinitions="*,*,*">
                            <Label Text="● Nyugalomban &lt; 0,15" FontSize="10" TextColor="#22C55E" />
                            <Label Grid.Column="1" Text="● Enyhe &lt; 0,50" FontSize="10" TextColor="#FB923C" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="● Erős ≥ 0,50" FontSize="10" TextColor="#EF4444" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <Label Text="A küszöbértékek kizárólag egyszerű, oktatási célú mozgásbesorolást jelentenek."
                           Style="{StaticResource Caption}" FontSize="11" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <!-- ================= 3. IRÁNYTŰ ================= -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource IconBadge}" BackgroundColor="#1AFBBF24">
                            <Label Text="🧭" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Iránytű" Style="{StaticResource SectionTitle}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding CompassStatus, Mode=OneWay}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                            <Label Text="Mérés" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            <Switch IsToggled="{Binding IsCompassOn, Mode=TwoWay}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">

                        <!-- Grafikus iránytű (extra): a lap a ViewModel DialRotation értékével forog -->
                        <Grid WidthRequest="150" HeightRequest="150" VerticalOptions="Center">
                            <Ellipse Fill="{StaticResource TileColor}" Stroke="{StaticResource StrokeColor}" StrokeThickness="2" />

                            <Grid Rotation="{Binding DialRotation, Mode=OneWay}">
                                <Ellipse Margin="10" Stroke="#33FBBF24" StrokeThickness="1" />
                                <Label Text="É" FontFamily="OpenSansSemibold" TextColor="{StaticResource ErrorColor}"
                                       HorizontalOptions="Center" VerticalOptions="Start" Margin="0,14,0,0" />
                                <Label Text="D" TextColor="{StaticResource MutedColor}"
                                       HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,14" />
                                <Label Text="K" TextColor="{StaticResource MutedColor}"
                                       HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,0" />
                                <Label Text="Ny" TextColor="{StaticResource MutedColor}"
                                       HorizontalOptions="Start" VerticalOptions="Center" Margin="14,0,0,0" />
                                <!-- Észak felé mutató tű -->
                                <Polygon Points="75,38 82,75 68,75" Fill="{StaticResource ErrorColor}" />
                                <Polygon Points="68,75 82,75 75,112" Fill="#55657F" />
                            </Grid>

                            <!-- Rögzített jelölő: a telefon teteje -->
                            <Polygon Points="75,2 81,12 69,12" Fill="{StaticResource CompassAccent}" />
                            <Ellipse WidthRequest="12" HeightRequest="12" Fill="{StaticResource CompassAccent}"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="IRÁNY" Style="{StaticResource FieldLabel}" />
                                <Label FontFamily="OpenSansSemibold" FontSize="40" TextColor="{StaticResource CompassAccent}"
                                       Text="{Binding Heading, Mode=OneWay, StringFormat='{0} °', TargetNullValue='– °'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="ÉGTÁJ" Style="{StaticResource FieldLabel}" />
                                <Label Style="{StaticResource BigValue}" FontSize="20"
                                       Text="{Binding CardinalDirection, Mode=OneWay}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Oroszi Sándor · Y3ZAKR · .NET MAUI labor beadandó"
                   Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,4,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
